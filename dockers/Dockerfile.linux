# Dockerfile for building Linux static libraries on any platform
# Base image: Ubuntu 22.04 LTS with build essentials
#
# Force linux/amd64: this image builds x86_64 with the image's NATIVE gcc and
# aarch64 with gcc-aarch64-linux-gnu. That split only holds on an amd64 host.
# On an arm64 host (Apple Silicon) an unpinned FROM yields an arm64 image, so the
# "native" leg silently produces aarch64 too -- both arches come out aarch64, the
# x86_64 output directory is wrong, and nothing errors. Same pin as Dockerfile.openwrt.
FROM --platform=linux/amd64 ubuntu:22.04

# Prevent interactive prompts during installation
ENV DEBIAN_FRONTEND=noninteractive

# Install build dependencies (includes aarch64 cross-compiler for --arch aarch64 builds)
# Restore world-readable bits on the apt keyrings before updating. Older Docker
# (seen with 19.03.8) can drop them depending on the storage driver, after which
# user '_apt' cannot read /etc/apt/trusted.gpg.d/*.gpg and every repository is
# rejected as unsigned: "NO_PUBKEY 871920D1991BC93C" plus
# "The key(s) ... are ignored as the file is not readable by user '_apt'".
# No-op on modern Docker.
RUN chmod 644 /etc/apt/trusted.gpg.d/*.gpg 2>/dev/null || true; \
    apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    git \
    wget \
    curl \
    zip \
    unzip \
    pkg-config \
    libssl-dev \
    zlib1g-dev \
    ca-certificates \
    python3 \
    python3-pip \
    gcc-aarch64-linux-gnu \
    g++-aarch64-linux-gnu \
    binutils-aarch64-linux-gnu \
    && rm -rf /var/lib/apt/lists/*

# Install Rust toolchain (needed for --dev mode: building ccgo from source)
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain stable --profile minimal
ENV PATH="/root/.cargo/bin:${PATH}"

# Set environment variables
ENV LANG=C.UTF-8 \
    LC_ALL=C.UTF-8

# Install ccgo from PyPI (pre-compiled wheel, much faster than cargo install)
RUN pip3 install --no-cache-dir ccgo

# Verify installations
RUN echo "=== Build Tools Verification ===" && \
    gcc --version && \
    g++ --version && \
    cmake --version && \
    python3 --version && \
    ccgo --version

# Set working directory
WORKDIR /workspace

# Entry point - execute build script
ENTRYPOINT ["/bin/bash", "-c"]
