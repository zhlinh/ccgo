get_filename_component(directory "${OUTPUT}" DIRECTORY)
file(MAKE_DIRECTORY "${directory}")
set(temporary "${OUTPUT}.tmp")
file(REMOVE "${temporary}")
if(APPLE)
    execute_process(COMMAND /usr/bin/libtool -static -o "${temporary}" ${INPUTS} RESULT_VARIABLE result)
elseif(MSVC)
    execute_process(COMMAND "${AR}" /NOLOGO "/OUT:${temporary}" ${INPUTS} RESULT_VARIABLE result)
else()
    # GNU ar's MRI parser does not support quoted paths. Stage archives under
    # simple relative names so spaces in source and build directories are safe.
    set(work "${OUTPUT}.merge")
    file(MAKE_DIRECTORY "${work}")
    set(mri "CREATE merged.a\n")
    set(index 0)
    foreach(input IN LISTS INPUTS)
        configure_file("${input}" "${work}/input-${index}.a" COPYONLY)
        string(APPEND mri "ADDLIB input-${index}.a\n")
        math(EXPR index "${index} + 1")
    endforeach()
    string(APPEND mri "SAVE\nEND\n")
    file(WRITE "${work}/merge.mri" "${mri}")
    execute_process(COMMAND "${AR}" -M INPUT_FILE "${work}/merge.mri"
        WORKING_DIRECTORY "${work}" RESULT_VARIABLE result)
    if(result EQUAL 0)
        file(RENAME "${work}/merged.a" "${temporary}")
    endif()
    file(REMOVE_RECURSE "${work}")
endif()
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Upstream static archive merge failed: ${result}")
endif()
if(NOT MSVC AND RANLIB)
    execute_process(COMMAND "${RANLIB}" "${temporary}" RESULT_VARIABLE result)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Upstream archive index failed: ${result}")
    endif()
endif()
file(RENAME "${temporary}" "${OUTPUT}")
