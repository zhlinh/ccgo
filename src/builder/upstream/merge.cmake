get_filename_component(directory "${OUTPUT}" DIRECTORY)
file(MAKE_DIRECTORY "${directory}")
set(temporary "${OUTPUT}.tmp")
file(REMOVE "${temporary}")
if(APPLE)
    execute_process(COMMAND /usr/bin/libtool -static -o "${temporary}" ${INPUTS} RESULT_VARIABLE result)
elseif(MSVC)
    execute_process(COMMAND "${AR}" /NOLOGO "/OUT:${temporary}" ${INPUTS} RESULT_VARIABLE result)
else()
    set(mri "CREATE \"${temporary}\"\n")
    foreach(input IN LISTS INPUTS)
        string(APPEND mri "ADDLIB \"${input}\"\n")
    endforeach()
    string(APPEND mri "SAVE\nEND\n")
    file(WRITE "${OUTPUT}.mri" "${mri}")
    execute_process(COMMAND "${AR}" -M INPUT_FILE "${OUTPUT}.mri" RESULT_VARIABLE result)
    file(REMOVE "${OUTPUT}.mri")
endif()
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Upstream static archive merge failed: ${result}")
endif()
if(NOT MSVC AND RANLIB)
    execute_process(COMMAND "${RANLIB}" "${temporary}" RESULT_VARIABLE result)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Upstream archive index failed: ${result}")
    endif()
endif()
file(RENAME "${temporary}" "${OUTPUT}")
